{
  "name": "SYNOVAX vault",
  "short_name": "SYNOVAX",
  "description": "Your encrypted memory vault for every AI you use.",
  "id": "/vault/",
  "start_url": "/vault/",
  "scope": "/vault/",
  "display": "standalone",
  "background_color": "#111111",
  "theme_color": "#111111",
  "share_target": { "action": "/vault/share", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
